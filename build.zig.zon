.{
    .name = .etcd,
    .version = "0.0.0",
    .fingerprint = 0x7a4b85841e7ef1bd, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // gRPC framing, status, and calls over HTTP/2, at the v0.1.1 release.
        .grpc = .{
            .url = "https://baskingspot.dev/grpc/v0.1.1.tar.gz",
            .hash = "grpc-0.1.1-t3Pkt1utBACzQ4T0BbHP_6Dt0fYF1CGIaBR8996leCc6",
        },
        // The typed message codec. Pinned past v0.2.0: the etcd Watch
        // request is a oneof, and the tag does not carry oneof support.
        .protobuf = .{
            .url = "git+https://github.com/baskingspot/protobuf#2ca73c26d990d4d57236d5e849dfdc36b6c6c5f8",
            .hash = "protobuf-0.2.0-cwbb_Uz-AgDC-kSCpmwFs9u660K7yOPJIQq_13noWLna",
        },
        // Deadlines, durations, and the compact time values gRPC carries.
        .stdx = .{
            .url = "https://baskingspot.dev/stdx/v0.5.0.tar.gz",
            .hash = "stdx-0.5.0-CcWegogqEQAvbEzD5F1r02a42hPX7GV82njuREakeC3a",
        },
        // The plain-text test runner. Lazy: a consumer never fetches it.
        .testingx = .{
            .url = "https://baskingspot.dev/testingx/v0.4.0.tar.gz",
            .hash = "testingx-0.4.0-ib95-2JkAwDVM639ma-akYafT4bdewLfpFaAEnLBzQXG",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
